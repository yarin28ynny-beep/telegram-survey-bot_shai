# סודות — טוקנים ומפתחות API אמיתיים. לעולם לא עולים ל-git.
# (.env.example כן עולה — הוא ה-template הציבורי בלי ערכים)
.env

# פלט build של Maven
target/

# קבצי IDE
.idea/
*.iml
.vscode/
out/

# נתוני משתמש בפועל (מכיל chat IDs, תשובות אמיתיות של הקהילה)
# הערה: מתחילים עם data/ ריקה בכוונה — הקבצים נוצרים אוטומטית בהרצה הראשונה
data/*.json

# קבצי מערכת הפעלה
.DS_Store
Thumbs.db
